# Copy to .env.local and adjust. .env.local is gitignored.

# ── Postgres ─────────────────────────────────────────────────────────────────
# The website connects as the narrow, read-only role.
DATABASE_URL=postgres://cbc_web:cbc_web_dev@localhost:5433/cbc

# Superuser connection, used only by the db:* tooling scripts (bootstrap /
# migrate / wait). Not used by the running app.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5433/postgres
DB_NAME=cbc
BOT_DB_PASSWORD=cbc_bot_dev
WEB_DB_PASSWORD=cbc_web_dev

# ── Revalidation ─────────────────────────────────────────────────────────────
# Shared secret the Discord bot presents to POST /api/revalidate so bot writes
# show up on the site immediately. Must match the bot's WEBSITE_REVALIDATE_SECRET.
REVALIDATE_SECRET=dev_revalidate_secret_change_me

# Public site origin, used for absolute URLs in metadata (OpenGraph, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:8443
